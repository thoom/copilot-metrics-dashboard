# GitHub API Settings
GITHUB_TOKEN=your_github_token_here
GITHUB_ORGANIZATION=your_organization_name
GITHUB_ENTERPRISE=your_enterprise_name_or_leave_empty

# Optional Settings (these have defaults)
GITHUB_API_VERSION=2022-11-28
GITHUB_API_SCOPE=organization

# Database Settings  
STORAGE_TYPE=sqlite
SQLITE_DB_PATH=/app/data/copilot-metrics.db

# Feature flags
ENABLE_DASHBOARD_FEATURE=true
ENABLE_SEATS_FEATURE=true
